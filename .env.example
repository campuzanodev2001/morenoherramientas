# ───────────────────────────────────────────────────────────────────────────
# Variables de entorno — Moreno Herramientas
# Copiá este archivo a .env.local y completá con valores reales.
# Validadas con Zod en lib/env.ts: la app no arranca si falta alguna requerida.
# ───────────────────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL en Supabase — connection string con pooler)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Auth (NextAuth v5)
NEXTAUTH_SECRET=  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
# OPCIONALES. Sin ambas, el provider de Google no se registra y el botón
# "Continuar con Google" no se muestra en /login ni /registro.
# Se sacan de Google Cloud Console (NO de Firebase):
#   APIs & Services > Credentials > Create credentials > OAuth client ID > Web
# Authorized redirect URIs que hay que cargar ahí:
#   http://localhost:3000/api/auth/callback/google
#   https://TU-DOMINIO/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MercadoPago
# Sandbox: credenciales de prueba (TEST-...). Producción: credenciales reales.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Envíos
ANDREANI_API_KEY=
ANDREANI_CLIENT_ID=
CORREO_ARG_USER=
CORREO_ARG_PASSWORD=

# Mails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ventas@morenoherramientas.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=  # string aleatorio de al menos 32 caracteres

# Monitoreo (opcionales en desarrollo)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=
AXIOM_DATASET=
